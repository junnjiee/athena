# Copy to .env and fill in what you have, then start the engine with:
#
#   uv run --env-file .env uvicorn athena.service:app --port 8000
#
# The engine reads os.environ directly and loads no file of its own, so the
# --env-file flag is what puts these into its environment. Plain `uv run` will
# ignore this file.

# The terrain service, which owns every operational area. The engine pulls a
# road graph by area id and holds no state of its own.
TERRAIN_SERVICE_URL=http://localhost:8787

# The model that reasons about enemy intent, as provider:name, resolved by
# pydantic-ai. Unset means openai:gpt-5.6-sol (athena/params.py). Any of these,
# or anything else pydantic-ai resolves:
#
#   openai:gpt-5.6-sol
#   anthropic:claude-opus-5
#   google:gemini-2.5-pro
#   ollama:llama3.3
ATHENA_MODEL=

# The key for whichever provider the line above names. One variable, not one
# per vendor: which client it reaches follows from ATHENA_MODEL and nothing
# else, so swapping provider is a change of these two lines.
#
# Left empty, key resolution falls to pydantic-ai, which reads whatever
# conventional variable that provider expects -- so a shell already exporting
# OPENAI_API_KEY or similar keeps working.
#
# Needed only for the enemy courses-of-action pass. Route studies and block
# forces are deterministic and run without any key at all.
PROVIDER_API_KEY=
