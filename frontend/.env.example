# Copy to .env.local and fill in what you have.

# Cesium ion account token (free tier). Without it the app falls back to
# Cesium's rate-limited demo token (slow tiles, dev only).
VITE_CESIUM_ION_TOKEN=

# Google Maps Platform key with "Map Tiles API" enabled -- powers RECON
# (photorealistic) mode via Google Photorealistic 3D Tiles. Free tier is fine
# for a demo. Without it, RECON falls back to the ion proxy asset (needs a real
# ion token above); with neither, the Recon toggle is disabled.
VITE_GOOGLE_MAPS_KEY=
