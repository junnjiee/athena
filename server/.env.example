# Copy to .env and fill in what you have.

# Browser origins allowed to call this service, comma-separated. Leave unset
# for local work -- that permits any localhost port, which is what the Vite dev
# server and docker-compose both use. A deployed frontend must be named here or
# every request from it is blocked by CORS.
CORS_ORIGINS=

# Battleground generations allowed per caller per minute. Generating fans out to
# AWS Terrain Tiles, Overpass, Terrascope and Esri on someone else's quota, so
# it is capped; other routes read from Postgres or memory and are not.
BATTLEGROUND_RATE_LIMIT=20

# NeonDB pooled connection string (from the Neon console's "Connection Details"
# panel -- hostname contains "-pooler", and it should include ?sslmode=require).
# Powers plan persistence (see src/db/). Without it, POST/GET /api/plans* fail.
DATABASE_URL=

# ElevenLabs API key -- powers the voice assistant. Stays server-side; the
# browser only ever receives a short-lived conversation token minted by
# GET /api/assistant/session. Without it the assistant dock shows
# "not configured" and the rest of the app works normally.
ELEVENLABS_API_KEY=

# The Athena agent's id. Run `bun run agent:sync` once after setting the key
# above -- it creates the agent from src/services/assistantAgent.ts (system
# prompt + tool catalog) and prints the id to paste here. Re-run it after
# editing that file to push prompt/tool changes.
ELEVENLABS_AGENT_ID=

# Optional: ElevenLabs voice for the assistant. Defaults to Rachel.
ELEVENLABS_VOICE_ID=
