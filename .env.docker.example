# Copy to .env, then `docker compose up --build`.
#
# Everything here is optional: the stack comes up without any of it. Terrain
# generation and plan drawing work as-is; the items below unlock the parts that
# need a third party.

# Lets the soldier-agents actually think. Without it the engine accepts a batch
# and every run fails at its first agent call -- the UI reports them as failed
# runs rather than pretending they succeeded.
OPENROUTER_API_KEY=

# Shared secret between the terrain service and the engine. Any string; both
# sides read this same variable, so it only matters that they match.
ENGINE_API_TOKEN=local-engine-token

# Simulations in flight per worker, and how many worker containers to run.
# Runs in a batch are independent, so throughput is roughly the product of the
# two -- raise them to finish a batch sooner, at the cost of more concurrent
# OpenRouter requests.
WORKER_CONCURRENCY=8
WORKER_REPLICAS=1

# Browser origins allowed to call the terrain service. Leave unset for local
# work: that permits any localhost port. Set it to your deployed frontend's
# exact origin (comma-separated for several) when deploying.
CORS_ORIGINS=

# Cesium ion token. Without it the globe falls back to Cesium's rate-limited
# demo token and world imagery loads noticeably slower.
VITE_CESIUM_ION_TOKEN=

# Voice assistant. Without these the assistant dock reports "not configured"
# and everything else works normally.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
