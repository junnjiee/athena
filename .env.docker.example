# Copy to .env, then `docker compose up --build`.
#
# Everything here is optional: the stack comes up without any of it. Terrain
# generation and plan drawing work as-is; the items below unlock the parts that
# need a third party.

# The model that reasons about enemy intent, as provider:name, and the key for
# whichever provider that names. Unset, the model defaults to
# openai:gpt-5.6-sol and the key falls back to whatever conventional variable
# that provider expects.
#
# Without them, route studies and block forces still work -- they are
# deterministic; only the S2 courses-of-action pass reaches a model, and it
# reports plainly when unset.
ATHENA_MODEL=
PROVIDER_API_KEY=

# Browser origins allowed to call the terrain service. Leave unset for local
# work: that permits any localhost port. Set it to your deployed frontend's
# exact origin (comma-separated for several) when deploying.
CORS_ORIGINS=

# Cesium ion token. Without it the globe falls back to Cesium's rate-limited
# demo token and world imagery loads noticeably slower.
VITE_CESIUM_ION_TOKEN=

# Google Maps Platform key with "Map Tiles API" enabled -- powers RECON
# (photorealistic) mode. Without it RECON falls back to the ion proxy asset
# (needs a real ion token above); with neither, the Recon toggle is disabled.
VITE_GOOGLE_MAPS_KEY=

# Voice assistant. Without these the assistant dock reports "not configured"
# and everything else works normally. Set the key first, then run
#   docker compose run --rm server node_modules/.bin/tsx scripts/sync-agent.ts
# to create the agent and print the id to paste below.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
